{
  "name": "chat-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "mobile": "pnpm --filter=@chat-app/mobile dev",
    "backend": "turbo run dev --filter=@chat-app/backend"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "pnpm@9.1.3"
}
