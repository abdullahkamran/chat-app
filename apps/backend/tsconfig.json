{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@chat-app/shared-types": ["../../packages/shared-types/src"],
      "@chat-app/socket-constants": ["../../packages/socket-constants/src"]
    }
  },
  "include": ["src/**/*", "../../packages/shared-types/src", "../../packages/socket-constants/src"]
}
